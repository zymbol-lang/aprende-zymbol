// ============================================================
// 08_pruebas.zy — la puerta de completitud
//
// Recorre el catálogo maestro de claves contra TODOS los idiomas
// registrados, el base incluido. Un idioma al que le falte una
// clave la devuelve tal cual (el caso identidad), y eso es lo que
// hace la comprobación decidible: como las claves llevan prefijo
// de dominio, ninguna puede coincidir con su propia traducción —
// tampoco en español, que es el idioma en el que está escrito el
// programa.
//
// TAL Y COMO ESTÁ, ESTA PRUEBA FALLA: al catálogo inglés le falta
// "fin.récord" a propósito. Añádela en idioma/english.zy y vuelve
// a ejecutarla.
//
// Ejecutar:  zymbol run juegos/ejemplos/08_pruebas.zy
//            zymbol run --vm juegos/ejemplos/08_pruebas.zy
// ============================================================

<# ./idioma/despacho => idioma
<# ./marco => marco
<# ./texto => txt

claves = idioma::claves()
lista  = idioma::idiomas()
n_claves = claves$#
n_idiomas = lista$#

>> "Puerta de completitud i18n" ¶
>> "claves: {n_claves}   idiomas: {n_idiomas}" ¶
>> ¶

// ── 1. toda clave resuelve en todo idioma ────────────────────

>> "── claves ────────────────────────────────────────" ¶
faltan = 0

@ código : lista {
    idioma::fijar(código)
    nombre = idioma::texto("idioma.nombre")
    ausentes = 0

    @ clave : claves {
        // El caso identidad: la traducción es la clave ⇒ falta.
        ? (idioma::texto(clave)) == clave {
            ? ausentes == 0 { >> "  [" código "] " nombre ¶ }
            >> "      FALTA  " clave ¶
            ausentes = ausentes + 1
        }
    }

    ? ausentes == 0 {
        >> "  [" código "] " (txt::derecha(nombre, 10)) "  {n_claves}/{n_claves}  OK" ¶
    } _ {
        >> "      → {ausentes} sin traducir" ¶
    }

    faltan = faltan + ausentes
}

// ── 2. las frases compuestas se ejercitan a ojo ──────────────
//
// Una búsqueda estática solo puede faltar; una frase compuesta
// puede estar MAL. Los valores no son al azar: 0 · 7 · 1234 son
// cero, un dígito y cuatro dígitos — donde se rompe un marcador
// con el ancho supuesto. 1 y 12 son las dos ramas de plural.

>> ¶
>> "── frases compuestas (revisar a ojo) ─────────────" ¶
@ código : lista {
    idioma::fijar(código)
    >> "  [" código "] " (idioma::marcador(0)) "·" (idioma::marcador(7)) "·" (idioma::marcador(1234)) ¶
    >> "        " (idioma::frase_partida(1)) ¶
    >> "        " (idioma::frase_partida(12)) ¶
}

// ── 3. el marco sigue cuadrando en todos los idiomas ─────────
//
// Lo que hay que probar no es solo que el texto exista, sino que
// la caja siga cuadrando cuando el texto cambia de idioma. Un
// panel bien construido tiene TODAS sus filas del mismo ancho en
// columnas de terminal. Se mide con txt::ancho, nunca con $#: una
// prueba que cuente grafemas daría PASS sobre un panel japonés
// visiblemente roto.

>> ¶
>> "── marcos ────────────────────────────────────────" ¶
descuadres = 0

@ código : lista {
    idioma::fijar(código)

    líneas = [
        marco.CENTRADO $+ idioma::texto("menú.título"),
        marco.SEPARADOR,
        idioma::texto("menú.velocidad"),
        marco::fila_menú(1, idioma::texto("menú.lento"), #1),
        marco::fila_menú(2, idioma::texto("menú.normal"), #0),
        marco::fila_menú(3, idioma::texto("menú.rápido"), #0),
        marco.SEPARADOR,
        idioma::texto("fin.puntaje") $+ ":  1234"
    ]

    filas = marco::construir(líneas, 3)
    esperado = txt::ancho(filas[1])
    malas = 0
    @ f : filas {
        ? txt::ancho(f) <> esperado { malas = malas + 1 }
    }

    ? malas == 0 {
        >> "  [" código "] {esperado} columnas — todas las filas cuadran" ¶
    } _ {
        >> "  [" código "] {malas} filas descuadradas de {esperado} columnas" ¶
    }
    descuadres = descuadres + malas
}

// ── veredicto ────────────────────────────────────────────────

>> ¶
? faltan == 0 && descuadres == 0 {
    >> "PASA — {n_claves} claves × {n_idiomas} idiomas, marcos cuadrados" ¶
} _ {
    >> "FALLA — {faltan} claves sin traducir, {descuadres} filas descuadradas" ¶
    >> ¶
    >> "Añade la clave que falta a idioma/english.zy y vuelve a" ¶
    >> "ejecutar. Ese es el ciclo de trabajo con la puerta puesta:" ¶
    >> "la prueba te dice al instante qué olvidaste." ¶
}
